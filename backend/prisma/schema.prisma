generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PersonType {
  LEAD
  CLIENT
  VENDOR
  APPLICANT
  STAFF
}

enum Surface {
  SITE_COM
  SITE_IN
  APP
  CAREER
  WHATSAPP
  EMAIL
  CALL
}

enum InteractionType {
  FORM
  CHAT
  APPLICATION
  CALL_LOG
}

enum ProjectStage {
  SCOPING
  IN_PROGRESS
  REVIEW
  DELIVERED
}

enum ProjectStatus {
  ACTIVE
  DELIVERED
  ON_HOLD
}

enum AppStage {
  APPLIED
  SCREENED
  INTERVIEW
  OFFER
  REJECTED
}

enum Role {
  ADMIN
  MANAGER
  SALES
  VENDOR
  VIEWER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadUrgency {
  HIGH
  MEDIUM
  LOW
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

enum SenderType {
  CUSTOMER
  STAFF
  AI
  SYSTEM
}

model Person {
  id               String         @id @default(uuid())
  fullName         String
  email            String?        @unique
  phone            String?        @unique
  type             PersonType     @default(LEAD)
  firstTouchSource Surface
  consentFlags     Json           @default("{}")
  createdAt        DateTime       @default(now())
  interactions     Interaction[]
  clientProjects   Project[]      @relation("ClientProjects")
  vendorProjects   Project[]      @relation("VendorProjects")
  applications     Application[]
  leads            Lead[]
  conversations    Conversation[]
}

model Staff {
  id                    String         @id @default(uuid())
  email                 String         @unique
  name                  String
  passwordHash          String
  role                  Role           @default(SALES)
  active                Boolean        @default(true)
  interactions          Interaction[]
  reviews               Application[]
  assignedLeads         Lead[]
  leadTasks             LeadTask[]
  assignedConversations Conversation[]
  messagesSent          ChatMessage[]
}

model Interaction {
  id         String          @id @default(uuid())
  personId   String
  person     Person          @relation(fields: [personId], references: [id])
  channel    Surface
  type       InteractionType
  payload    Json
  ownerId    String?
  owner      Staff?          @relation(fields: [ownerId], references: [id])
  occurredAt DateTime        @default(now())

  @@index([personId, occurredAt])
}

model Lead {
  id              String      @id @default(uuid())
  personId        String
  person          Person      @relation(fields: [personId], references: [id])
  title           String
  stage           LeadStage   @default(NEW)
  score           Int         @default(50)
  urgency         LeadUrgency @default(MEDIUM)
  estimatedValue  Float?
  serviceType     String?
  sourceSurface   Surface
  assignedStaffId String?
  assignedStaff   Staff?      @relation(fields: [assignedStaffId], references: [id])
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tasks           LeadTask[]

  @@index([stage, score])
  @@index([assignedStaffId])
}

model LeadTask {
  id              String    @id @default(uuid())
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedStaffId String?
  assignedStaff   Staff?    @relation(fields: [assignedStaffId], references: [id])
  title           String
  dueAt           DateTime
  completed       Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model Conversation {
  id                String             @id @default(uuid())
  personId          String
  person            Person             @relation(fields: [personId], references: [id])
  channel           Surface
  status            ConversationStatus @default(OPEN)
  assignedStaffId   String?
  assignedStaff     Staff?             @relation(fields: [assignedStaffId], references: [id])
  lastMessageAt     DateTime           @default(now())
  slaDueAt          DateTime?
  firstRespondedAt  DateTime?
  createdAt         DateTime           @default(now())
  messages          ChatMessage[]

  @@index([status, channel])
  @@index([assignedStaffId])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SenderType
  senderStaffId  String?
  senderStaff    Staff?       @relation(fields: [senderStaffId], references: [id])
  content        String
  isInternalNote Boolean      @default(false)
  channel        Surface
  attachments    Json         @default("[]")
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model CannedReply {
  id        String   @id @default(uuid())
  shortcut  String   @unique
  title     String
  content   String
  category  String?
  createdAt DateTime @default(now())
}

model Project {
  id            String        @id @default(uuid())
  clientId      String
  client        Person        @relation("ClientProjects", fields: [clientId], references: [id])
  vendorId      String?
  vendor        Person?       @relation("VendorProjects", fields: [vendorId], references: [id])
  serviceType   String
  stage         ProjectStage  @default(SCOPING)
  status        ProjectStatus @default(ACTIVE)
  sourceSurface Surface
  createdAt     DateTime      @default(now())
}

model JobPosting {
  id           String        @id @default(uuid())
  title        String
  open         Boolean       @default(true)
  applications Application[]
}

model Application {
  id         String     @id @default(uuid())
  personId   String
  person     Person     @relation(fields: [personId], references: [id])
  roleId     String
  role       JobPosting @relation(fields: [roleId], references: [id])
  stage      AppStage   @default(APPLIED)
  resumeUrl  String?
  reviewerId String?
  reviewer   Staff?     @relation(fields: [reviewerId], references: [id])
}

model AuditLog {
  id       String   @id @default(uuid())
  actorId  String?
  action   String
  entity   String
  entityId String
  diff     Json?
  at       DateTime @default(now())
}

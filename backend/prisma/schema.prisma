generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PersonType {
  LEAD
  CLIENT
  VENDOR
  APPLICANT
  STAFF
}

enum Surface {
  SITE_COM
  SITE_IN
  APP
  CAREER
  WHATSAPP
  EMAIL
  CALL
}

enum InteractionType {
  FORM
  CHAT
  APPLICATION
  CALL_LOG
}

enum ProjectStage {
  SCOPING
  IN_PROGRESS
  REVIEW
  DELIVERED
}

enum ProjectStatus {
  ACTIVE
  DELIVERED
  ON_HOLD
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum DeliverableStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum RevisionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DECLINED
}

enum PayoutStatus {
  PENDING
  APPROVED
  RELEASED
  HELD
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  BANK_TRANSFER
  UPI
  STRIPE
  CASH
}

enum NotificationType {
  SLA_BREACH
  LEAD_ASSIGNED
  PAYMENT_RECEIVED
  MILESTONE_COMPLETED
  REVISION_REQUESTED
  SYSTEM_ALERT
}

enum AppStage {
  APPLIED
  SCREENED
  INTERVIEW
  OFFER
  REJECTED
}

enum Role {
  ADMIN
  MANAGER
  SALES
  VENDOR
  VIEWER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadUrgency {
  HIGH
  MEDIUM
  LOW
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
  ESCALATED
}

enum SenderType {
  CUSTOMER
  STAFF
  AI
  SYSTEM
}

enum PricingModel {
  FIXED
  HOURLY
  MILESTONE
  CUSTOM
}

enum PricingConditionType {
  MIN_BUDGET
  SURFACE_PROMO
  VOLUME_DISCOUNT
  SPECIAL_SURFACE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
  SMS
}

enum CommsDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  OPTED_OUT
}

model Person {
  id               String          @id @default(uuid())
  fullName         String
  email            String?         @unique
  phone            String?         @unique
  type             PersonType      @default(LEAD)
  firstTouchSource Surface
  consentFlags     Json            @default("{}")
  createdAt        DateTime        @default(now())
  interactions     Interaction[]
  clientProjects   Project[]       @relation("ClientProjects")
  vendorProjects   Project[]       @relation("VendorProjects")
  applications     Application[]
  leads            Lead[]
  conversations    Conversation[]
  vendorProfile    VendorProfile?
  campusAmbassador CampusAmbassador?
  ambassadorReferrals AmbassadorReferral[] @relation("ReferredPerson")
  invoices         Invoice[]       @relation("ClientInvoices")
}

model Staff {
  id                    String         @id @default(uuid())
  email                 String         @unique
  name                  String
  passwordHash          String
  role                  Role           @default(SALES)
  active                Boolean        @default(true)
  interactions          Interaction[]
  reviews               Application[]
  assignedLeads         Lead[]
  leadTasks             LeadTask[]
  assignedConversations Conversation[]
  messagesSent          ChatMessage[]
  blogPosts             BlogPost[]
  routingRules          RoutingRule[]  @relation("RoutingRuleStaff")
}

model Interaction {
  id         String          @id @default(uuid())
  personId   String
  person     Person          @relation(fields: [personId], references: [id])
  channel    Surface
  type       InteractionType
  payload    Json
  ownerId    String?
  owner      Staff?          @relation(fields: [ownerId], references: [id])
  occurredAt DateTime        @default(now())

  @@index([personId, occurredAt])
}

model Lead {
  id              String      @id @default(uuid())
  personId        String
  person          Person      @relation(fields: [personId], references: [id])
  title           String
  stage           LeadStage   @default(NEW)
  score           Int         @default(50)
  urgency         LeadUrgency @default(MEDIUM)
  estimatedValue  Float?
  serviceType     String?
  sourceSurface   Surface
  assignedStaffId String?
  assignedStaff   Staff?      @relation(fields: [assignedStaffId], references: [id])
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tasks           LeadTask[]

  @@index([stage, score])
  @@index([assignedStaffId])
}

model LeadTask {
  id              String   @id @default(uuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedStaffId String?
  assignedStaff   Staff?   @relation(fields: [assignedStaffId], references: [id])
  title           String
  dueAt           DateTime
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Conversation {
  id                String             @id @default(uuid())
  personId          String
  person            Person             @relation(fields: [personId], references: [id])
  channel           Surface
  status            ConversationStatus @default(OPEN)
  assignedStaffId   String?
  assignedStaff     Staff?             @relation(fields: [assignedStaffId], references: [id])
  lastMessageAt     DateTime           @default(now())
  slaDueAt          DateTime?
  firstRespondedAt  DateTime?
  createdAt         DateTime           @default(now())
  messages          ChatMessage[]

  @@index([status, channel])
  @@index([assignedStaffId])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SenderType
  senderStaffId  String?
  senderStaff    Staff?       @relation(fields: [senderStaffId], references: [id])
  content        String
  isInternalNote Boolean      @default(false)
  channel        Surface
  attachments    Json         @default("[]")
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model CannedReply {
  id        String   @id @default(uuid())
  shortcut  String   @unique
  title     String
  content   String
  category  String?
  createdAt DateTime @default(now())
}

model Project {
  id            String              @id @default(uuid())
  clientId      String
  client        Person              @relation("ClientProjects", fields: [clientId], references: [id])
  vendorId      String?
  vendor        Person?             @relation("VendorProjects", fields: [vendorId], references: [id])
  title         String              @default("Client Project")
  description   String?
  serviceType   String
  stage         ProjectStage        @default(SCOPING)
  status        ProjectStatus       @default(ACTIVE)
  budget        Float?
  currency      String              @default("INR")
  deadline      DateTime?
  sourceSurface Surface
  createdAt     DateTime            @default(now())
  milestones    ProjectMilestone[]
  deliverables  ProjectDeliverable[]
  revisions     RevisionRequest[]
  payouts       VendorPayout[]
  invoices      Invoice[]           @relation("ProjectInvoices")
  files         FileRecord[]

  @@index([stage, status])
}

model ProjectMilestone {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  amount      Float?
  createdAt   DateTime        @default(now())
}

model ProjectDeliverable {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String?
  version     Int               @default(1)
  status      DeliverableStatus @default(SUBMITTED)
  submittedAt DateTime          @default(now())
}

model RevisionRequest {
  id            String         @id @default(uuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverableId String?
  requestedBy   String
  feedback      String
  status        RevisionStatus @default(OPEN)
  createdAt     DateTime       @default(now())
}

model VendorProfile {
  id                String         @id @default(uuid())
  personId          String         @unique
  person            Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  skills            String[]       @default([])
  maxCapacity       Int            @default(3)
  rating            Float          @default(5.0)
  completedProjects Int            @default(0)
  ndaSigned         Boolean        @default(false)
  ndaSignedAt       DateTime?
  contractUrl       String?
  createdAt         DateTime       @default(now())
  payouts           VendorPayout[]
}

model VendorPayout {
  id          String        @id @default(uuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id])
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])
  milestoneId String?
  amount      Float
  status      PayoutStatus  @default(PENDING)
  releasedAt  DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
}

model JobPosting {
  id           String        @id @default(uuid())
  title        String
  department   String        @default("General")
  location     String        @default("Remote")
  type         String        @default("FULL_TIME")
  experience   String?
  salaryRange  String?
  description  String?
  requirements String[]      @default([])
  open         Boolean       @default(true)
  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([department, open])
}

model Application {
  id                   String     @id @default(uuid())
  personId             String
  person               Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  roleId               String
  role                 JobPosting @relation(fields: [roleId], references: [id], onDelete: Cascade)
  stage                AppStage   @default(APPLIED)
  resumeUrl            String?
  portfolioUrl         String?
  yearsOfExperience    Float?
  skills               String[]   @default([])
  aiMatchScore         Int?
  aiEvaluation         Json?
  interviewNotes       String?
  interviewScheduledAt DateTime?
  offerAmount          Float?
  referralCode         String?
  reviewerId           String?
  reviewer             Staff?     @relation(fields: [reviewerId], references: [id])
  appliedAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt

  @@index([stage, roleId])
}

model CampusAmbassador {
  id                    String               @id @default(uuid())
  personId              String               @unique
  person                Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  college               String
  graduationYear        Int?
  referralCode          String               @unique
  totalReferrals        Int                  @default(0)
  successfulConversions Int                  @default(0)
  commissionEarned      Float                @default(0.0)
  payoutStatus          PayoutStatus         @default(PENDING)
  status                String               @default("ACTIVE")
  createdAt             DateTime             @default(now())
  referrals             AmbassadorReferral[]

  @@index([referralCode, status])
}

model AmbassadorReferral {
  id               String           @id @default(uuid())
  ambassadorId     String
  ambassador       CampusAmbassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referredPersonId String
  referredPerson   Person           @relation("ReferredPerson", fields: [referredPersonId], references: [id], onDelete: Cascade)
  type             String           @default("LEAD")
  status           String           @default("ATTRIBUTED")
  rewardAmount     Float            @default(0.0)
  createdAt        DateTime         @default(now())

  @@index([ambassadorId, referredPersonId])
}

model AuditLog {
  id       String   @id @default(uuid())
  actorId  String?
  action   String
  entity   String
  entityId String
  diff     Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, at])
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  clientId       String
  client         Person        @relation("ClientInvoices", fields: [clientId], references: [id])
  projectId      String?
  project        Project?      @relation("ProjectInvoices", fields: [projectId], references: [id])
  milestoneId    String?
  title          String
  description    String?
  subtotal       Float
  taxAmount      Float         @default(0.0)
  totalAmount    Float
  currency       String        @default("INR")
  status         InvoiceStatus @default(PENDING)
  dueDate        DateTime?
  paidAt         DateTime?
  gatewayOrderId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  payments       Payment[]

  @@index([clientId, status])
  @@index([projectId, status])
}

model Payment {
  id               String        @id @default(uuid())
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           Float
  currency         String        @default("INR")
  method           PaymentMethod @default(RAZORPAY)
  transactionRef   String?
  gatewayPaymentId String?
  status           String        @default("SUCCESS")
  capturedAt       DateTime      @default(now())
  notes            String?

  @@index([invoiceId, status])
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String           // Staff ID or Person ID
  title       String
  message     String
  type        NotificationType @default(SYSTEM_ALERT)
  read        Boolean          @default(false)
  readAt      DateTime?
  link        String?
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())

  @@index([recipientId, read])
}

model AutomationRule {
  id          String    @id @default(uuid())
  name        String
  description String?
  triggerType String    // SLA_CHECK, STALE_LEADS, OVERDUE_INVOICES
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  config      Json      @default("{}")
  createdAt   DateTime  @default(now())
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  tags        String[]  @default([])
  surface     Surface   @default(SITE_COM)
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  author      Staff?    @relation(fields: [authorId], references: [id])
  viewsCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([slug])
  @@index([published, surface])
}

model CaseStudy {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  clientName     String
  serviceType    String
  description    String
  outcomeMetrics Json     @default("{}")
  coverImage     String?
  tags           String[] @default([])
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([slug])
  @@index([published])
}

model Testimonial {
  id         String   @id @default(uuid())
  clientName String
  clientRole String?
  company    String?
  avatarUrl  String?
  rating     Int      @default(5)
  reviewText String
  verified   Boolean  @default(true)
  surface    Surface  @default(SITE_COM)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([surface, verified])
}

model FileRecord {
  id            String   @id @default(uuid())
  originalName  String
  filename      String   @unique
  mimeType      String
  size          Int
  pathUrl       String
  storageType   String   @default("LOCAL")
  uploadedBy    String?
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deliverableId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([filename])
  @@index([projectId])
}

model ServiceItem {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  description  String
  category     String
  basePrice    Float
  currency     String        @default("INR")
  pricingModel PricingModel  @default(FIXED)
  deliverables String[]      @default([])
  surfaces     Surface[]     @default([SITE_COM, SITE_IN, APP])
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  pricingRules PricingRule[]

  @@index([slug])
  @@index([category, active])
}

model PricingRule {
  id                 String               @id @default(uuid())
  name               String
  description        String?
  serviceId          String?
  service            ServiceItem?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  conditionType      PricingConditionType @default(MIN_BUDGET)
  discountPercentage Float?
  markupPercentage   Float?
  minBudget          Float?
  targetSurface      Surface?
  validFrom          DateTime?
  validUntil         DateTime?
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  @@index([serviceId, active])
  @@index([targetSurface, active])
}

model FeatureFlag {
  id                String   @id @default(uuid())
  key               String   @unique
  name              String
  description       String?
  enabled           Boolean  @default(true)
  surface           Surface?
  rolloutPercentage Int      @default(100)
  config            Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([key])
  @@index([surface, enabled])
}

model RoutingRule {
  id                String    @id @default(uuid())
  name              String
  description       String?
  priority          Int       @default(0)
  sourceSurface     Surface?
  serviceCategory   String?
  minEstimatedValue Float?
  keywordMatch      String[]  @default([])
  assignedStaffId   String?
  assignedStaff     Staff?    @relation("RoutingRuleStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  targetRole        Role?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([priority, active])
  @@index([sourceSurface, active])
}

model CommsLog {
  id             String              @id @default(uuid())
  recipientId    String?
  recipientEmail String?
  recipientPhone String?
  channel        NotificationChannel
  template       String?
  subject        String?
  content        String
  status         CommsDeliveryStatus @default(SENT)
  externalId     String?
  errorMessage   String?
  metadata       Json                @default("{}")
  sentAt         DateTime            @default(now())

  @@index([recipientId, channel])
  @@index([status, sentAt])
}



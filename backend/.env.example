# Server
PORT=8000
NODE_ENV=development

# Database (Neon PostgreSQL)
# DATABASE_URL: Pooled connection string (ends with -pooler in Neon)
# DIRECT_URL: Direct connection string (without -pooler, used for migrations)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/karyasaarthi?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/karyasaarthi?sslmode=require"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_ACCESS_SECRET="karyasaarthi_access_secret_change_in_production"
JWT_REFRESH_SECRET="karyasaarthi_refresh_secret_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# External Integrations
ANTHROPIC_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
